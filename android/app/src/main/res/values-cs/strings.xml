    <string name="guide_step1_title">1. Wi‑Fi</string>
    <string name="guide_step1_desc">Turn on phone Wi-Fi near the router (no internet needed).</string>
    <string name="guide_step2_title">2. Rotate 360°</string>
    <string name="guide_step2_desc">Walk slowly around the rubble aiming your phone.</string>
